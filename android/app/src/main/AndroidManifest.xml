<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <activity
            android:name=".ComposeMainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- El intent-filter de lanzador (MAIN/LAUNCHER) vive en los 4
                 <activity-alias> de abajo, no aquí — así el icono real
                 puede cambiar según el tema de plataforma sin tocar esta
                 actividad para nada (ver IconSwitcher.kt). -->
            <!-- Deep link de vuelta desde /movil/enlazar (Custom Tab) con el
                 sessionToken del login real — ver ComposeMainActivity.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="paragon" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- "Añadir a Paragon" desde el Sharesheet del sistema (compartir un
             enlace/título desde Chrome, YouTube...) — ver ShareReceiverActivity.kt. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:label="Añadir a Paragon"
            android:theme="@style/AppTheme.NoActionBar"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Icono dinámico por tema de plataforma (Ajustes → Apariencia, ver
          ThemeStore.setPlatform() / IconSwitcher.kt) — Android no deja
          cambiar `android:icon` de una actividad en caliente, así que la
          técnica real es esta: 4 alias del MISMO ComposeMainActivity, cada
          uno con su propio icono de lanzador, y solo uno `enabled` a la
          vez (lo gestiona IconSwitcher.applyLauncherIcon, no el manifiesto
          — aquí solo se fija el estado inicial de instalación, Paragon).
        -->
        <activity-alias
            android:name=".IconParagon"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPlayStation"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_playstation"
            android:roundIcon="@mipmap/ic_launcher_playstation_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconXbox"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_xbox"
            android:roundIcon="@mipmap/ic_launcher_xbox_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSteam"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_steam"
            android:roundIcon="@mipmap/ic_launcher_steam_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Notificaciones push nativas (FCM) — ver
             com.paragon.app.push.ParagonFirebaseMessagingService y
             POST /api/mobile/push-token en el proyecto Next.js. Solo hace
             algo de verdad si android/app/google-services.json existe
             (ver la condición en app/build.gradle); sin eso, el sistema
             simplemente no tiene ningún token que darle a este servicio. -->
        <service
            android:name=".push.ParagonFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_paragon" />

        <receiver
            android:name=".widget.PinnedGameWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pinned_game_widget_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sin diálogo de permiso real (normal, se concede sola) — la necesita
         ConnectivityObserver.kt para saber cuándo ha vuelto la red y
         disparar la sincronización de notas pendientes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ exige pedir este permiso en tiempo de ejecución para
         poder mostrar CUALQUIER notificación, incluidas las push — ver la
         petición en ComposeMainActivity.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
