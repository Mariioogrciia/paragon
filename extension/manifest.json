{
  "manifest_version": 3,
  "name": "Paragon — Sincronizar PSN y Epic",
  "description": "Sincroniza tus trofeos de PlayStation y tus logros de Epic con Paragon leyendo tu propia sesión en este navegador, sin copiar tokens a mano.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://platinos-nine.vercel.app/movil/enlazar-extension*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.epicgames.com/*"],
      "js": ["epic.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ca.account.sony.com/*",
    "https://store.epicgames.com/*",
    "https://platinos-nine.vercel.app/*"
  ],
  "permissions": ["storage"]
}
