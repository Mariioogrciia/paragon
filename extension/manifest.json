{
  "manifest_version": 3,
  "name": "__MSG_nombre__",
  "description": "__MSG_descripcion__",
  "default_locale": "es",
  "version": "1.4.0",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.paragontrophies.com/movil/enlazar-extension*",
        "https://platinos-nine.vercel.app/movil/enlazar-extension*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.paragontrophies.com/*",
        "https://platinos-nine.vercel.app/*"
      ],
      "js": [
        "marca.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://store.epicgames.com/*"
      ],
      "js": [
        "epic.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ca.account.sony.com/*",
    "https://store.epicgames.com/*",
    "https://www.paragontrophies.com/*",
    "https://platinos-nine.vercel.app/*"
  ],
  "permissions": [
    "storage"
  ]
}
