<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".ParagonApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ComposeMainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- El intent-filter de lanzador (MAIN/LAUNCHER) vive en los 4
                 <activity-alias> de abajo, no aquí — así el icono real
                 puede cambiar según el tema de plataforma sin tocar esta
                 actividad para nada (ver IconSwitcher.kt). -->
            <!-- Deep link de vuelta desde /movil/enlazar (Custom Tab) con el
                 sessionToken del login real — ver ComposeMainActivity.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="paragon" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- "Añadir a Paragon" desde el Sharesheet del sistema (compartir un
             enlace/título desde Chrome, YouTube...) — ver ShareReceiverActivity.kt. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:label="Añadir a Paragon"
            android:theme="@style/AppTheme.NoActionBar"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Icono a elegir (Ajustes → Apariencia → Icono, ver IconSwitcher.kt en
          :shared). Android no deja cambiar `android:icon` en caliente, así
          que hay un <activity-alias> del MISMO ComposeMainActivity por icono
          y solo uno `enabled` a la vez. Aquí solo el estado de instalación.
        -->
        <activity-alias
            android:name=".IconParagon"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOro"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_oro"
            android:roundIcon="@mipmap/ic_launcher_oro_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconClaro"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_claro"
            android:roundIcon="@mipmap/ic_launcher_claro_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNeon"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_neon"
            android:roundIcon="@mipmap/ic_launcher_neon_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconEsmeralda"
            android:targetActivity=".ComposeMainActivity"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_esmeralda"
            android:roundIcon="@mipmap/ic_launcher_esmeralda_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Notificaciones push nativas (FCM) — ver
             com.paragon.app.push.ParagonFirebaseMessagingService y
             POST /api/mobile/push-token en el proyecto Next.js. Solo hace
             algo de verdad si android/app/google-services.json existe
             (ver la condición en app/build.gradle); sin eso, el sistema
             simplemente no tiene ningún token que darle a este servicio. -->
        <!-- Idioma por app en Android < 13: AppCompat guarda aquí el elegido en Ajustes. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".push.ParagonFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_paragon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificacion_acento" />

        <receiver
            android:name=".widget.PinnedGameWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pinned_game_widget_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sin diálogo de permiso real (normal, se concede sola) — la necesita
         ConnectivityObserver.kt para saber cuándo ha vuelto la red y
         disparar la sincronización de notas pendientes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ exige pedir este permiso en tiempo de ejecución para
         poder mostrar CUALQUIER notificación, incluidas las push — ver la
         petición en ComposeMainActivity.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
