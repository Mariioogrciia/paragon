            android:data="paragon://open?path=/biblioteca"
            android:targetPackage="com.paragon.app"
            android:targetClass="com.paragon.app.ComposeMainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="ligas"
        android:enabled="true"
        android:icon="@drawable/ic_atajo_ligas"
