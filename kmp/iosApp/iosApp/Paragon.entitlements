<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs). Xcode lo cambia a "production" al exportar para TestFlight/App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Compartido con el widget (ParagonWidget): ahí deja la app el juego anclado. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.paragon.app.kmp</string>
	</array>
</dict>
</plist>
